<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>taipan</AssemblyName>
    <RootNamespace>Taipan.Cli</RootNamespace>
  </PropertyGroup>

  <!-- The `taipan` command as a .NET tool (SPEC §12.2). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>taipan</ToolCommandName>
    <PackageId>TaipanLang</PackageId>
    <Description>The Taipan compiler: a statically typed language with Python's syntax, compiled to .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Roslyn's messages aren't shown to users, so its translations needn't ship. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taipan.Compiler\Taipan.Compiler.csproj" />
    <ProjectReference Include="..\Taipan.Runtime\Taipan.Runtime.csproj" />
  </ItemGroup>

</Project>
