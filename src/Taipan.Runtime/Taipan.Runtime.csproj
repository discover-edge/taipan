<Project Sdk="Microsoft.NET.Sdk">
  <!-- The library compiled programs reference (SPEC §12.2). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TaipanLang.Runtime</PackageId>
    <Description>The runtime library that programs compiled by Taipan reference.</Description>
    <!-- CPython's C API, for extension modules (SPEC §17). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.0.5" />
  </ItemGroup>
</Project>
