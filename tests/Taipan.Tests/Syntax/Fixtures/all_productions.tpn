const LIMIT: int = 1_000

@dataclass
class Service:
    name: str
    replicas: int
    tags: list[str]

class Base:
    count: int = 0

    def __init__(self):
        pass

    def bump(self, by: int = 1):
        self.count += by

class Derived(Base):
    pass

    @override
    def bump(self, by: int = 2):
        super().bump(by)

enum Health:
    Ok
    Degraded(healthy: int, total: int,)
    Down

def classify(code: int, label: str? = None) -> str:
    match code:
        0: return "zero"
        -1: return "minus one"
        _:
            pass
    let name = label ?? "none"
    var parts: dict[str, list[int?]] = {}
    parts["a"] = [1, None, 3,]
    parts["a"] += [4]
    if name is None:
        return "unreachable"
    elif label is some l:
        return f"{l}: {len(parts["a"])}"
    else:
        return name

def main():
    let svc = Service(name="api", replicas=3, tags=["web"])
    svc.replicas -= 1
    var i = 0
    while i < LIMIT and not (i == 5 or i in [7, 8]):
        i *= 2
        if i // 3 % 2 != 0 and "x" not in svc.tags:
            break
        continue
    for t in svc.tags:
        print(t, -i, 2.5e-3 / 1, True, False)
    match Health.Ok:
        Ok: print("ok")
        Health.Degraded(h, t): print(h, t)
        Down: return
    def adder(n: int) -> Callable[[int], int]:
        return lambda x: x + n
    let pick: Callable[[int, str], None]? = lambda _, s: print(s)
    print(sorted([2, 1], key=lambda: 0), adder(1)(2))
    let b: Base? = Derived()
    if isinstance(b, Derived) and b is not None or b is None:
        match b:
            Derived(count=c): print(c)
            _: pass
    print((b as Derived?) is None)
    try:
        raise ValueError("v")
    except (ValueError, KeyError) as e:
        print(e)
    except json.JSONDecodeError:
        raise
    except:
        pass
    else:
        pass
    finally:
        pass

main()
