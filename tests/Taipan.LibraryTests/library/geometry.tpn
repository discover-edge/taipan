import shapes

const VERSION = "1.0"

def total_area(items: list[shapes.Shape]) -> float:
    var total = 0.0
    for item in items:
        total += shapes.area(item)
    return total

# An async function is a C# async method (SPEC §14.2, M33).
async def area_later(items: list[shapes.Shape]) -> float:
    return total_area(items)
