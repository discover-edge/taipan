# Shapes for the C# tests to call (SPEC §14).
const SIDES = 4

enum Shape:
    Circle(r: float)
    Square(side: float)

class UnknownShape(Exception):
    name: str

    def __init__(self, name: str):
        self.name = name
        super().__init__(f"unknown shape: {name}")

@dataclass
class Point:
    x: float
    y: float = 0.0

    def moved(self, by: float = 1.0) -> Point:
        return Point(self.x + by, self.y + by)

class Counter:
    count: int
    _secret: int

    def __init__(self, start: int = 0):
        self.count = start
        self._secret = SIDES

    def bump(self) -> int:
        self.count += 1
        return self.count

class Box[T]:
    value: T

    def __init__(self, value: T):
        self.value = value

    def get(self) -> T:
        return self.value

def wrap[T](value: T) -> Box[T]:
    return Box(value)

def area(shape: Shape) -> float:
    return match shape:
        Circle(r): 3.0 * r * r
        Square(side): side * side

def parse(name: str) -> Shape:
    if name == "circle":
        return Circle(1.0)
    raise UnknownShape(name)

def scale(p: Point, by: float = 2.0) -> Point:
    return Point(p.x * by, p.y * by)

def corners(name: str) -> int:
    let known = {"square": SIDES, "triangle": 3}
    return known[name]

def doubled(n: int) -> int:
    return n * 2

def apply(f: Callable[[int], int], x: int) -> int:
    return f(x)

def _helper() -> int:
    return 1

# Special methods, properties, static and class methods and class attributes (SPEC §4.8, §14).
class Money:
    cents: int
    made: ClassVar[int] = 0

    def __init__(self, cents: int):
        self.cents = cents
        Money.made += 1

    @property
    def dollars(self) -> float:
        return self.cents / 100

    @dollars.setter
    def dollars(self, value: float):
        self.cents = int(value * 100)

    @staticmethod
    def zero() -> Money:
        return Money(0)

    @classmethod
    def of(cls, cents: int) -> Money:
        return cls(cents)

    def __eq__(self, other: Money) -> bool:
        return self.cents == other.cents

    def __hash__(self) -> int:
        return self.cents

    def __str__(self) -> str:
        return f"${self.dollars}"

class Polygon(ABC):
    @abstractmethod
    def sides(self) -> int: ...

# Parameter kinds (SPEC §4.2, §14.2).
def total(*xs: float) -> float:
    var sum = 0.0
    for x in xs:
        sum += x
    return sum

def tagged(name: str, /, *, upper: bool = False, **tags: int) -> str:
    var shown = name
    if upper:
        shown = name.upper()
    return f"{shown} {len(tags)}"
