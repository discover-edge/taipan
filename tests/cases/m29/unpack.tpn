# Nested, list and starred unpacking (SPEC §3.8).
let (a, b), c = ((1, "x"), 2.5)
print(a, b, c)

let xs = [10, 20, 30, 40]
let first, *rest = xs
print(first, rest)
let head, *_, last = "a,b,c".split(",")
print(head, last)
let *init, final = xs
print(init, final)
let p, q = [1, 2]
print(p, q)

let t = (1, 2, 3)
let one, *more = t
print(one, more)

var u = 0
var v = 0
var w: list[int] = []
u, *w = xs
(u, v), w[0] = ((5, 6), 99)
print(u, v, w)

let d = {"k": 1, "j": 2}
for i, (k, value) in enumerate(d.items()):
    print(i, k, value)
for (x, y) in [(1, 2), (3, 4)]:
    print(x + y)
for g, *others in [[1, 2, 3], [4]]:
    print(g, others)

try:
    let m, n = [1, 2, 3]
    print(m, n)
except ValueError as e:
    print(e)
try:
    let m, n = [1]
    print(m, n)
except ValueError as e:
    print(e)
try:
    let m, *n, o = [1]
    print(m, n, o)
except ValueError as e:
    print(e)
let r, s = [1]
