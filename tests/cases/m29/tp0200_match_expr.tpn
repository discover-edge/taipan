# A block arm gives its last expression's value (SPEC §5.1.1).
def pick(n: int) -> int:
    for i in [1, 2]:
        let x = match n:
            0:
                print("zero")
            1:
                break
            2:
                return 5
            _:
                n
        print(x, i)
    return 0
print(pick(3))
