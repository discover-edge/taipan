# Functions as values (SPEC §3.7).

def double(x: int) -> int:
    return x * 2

def apply_twice(f: Callable[[int], int], x: int) -> int:
    return f(f(x))

print(apply_twice(double, 3))
print(apply_twice(lambda x: x - 1, 3))

# Stored in lists, dicts and fields.
let ops: dict[str, Callable[[int, int], int]] = {"add": lambda a, b: a + b, "mul": lambda a, b: a * b}
print(ops["add"](2, 3), ops["mul"](2, 3))

@dataclass
class Button:
    label: str
    on_click: Callable[[str], str]

let b = Button("ok", lambda s: s + " clicked")
print(b.on_click(b.label))

# Optional functions are narrowed before they're called.
var handler: Callable[[], str]? = None
if handler is None:
    print("no handler")
handler = lambda: "handled"
if handler is some h:
    print(h())

# A result of None: the body's value, if any, is discarded.
let log: Callable[[str], None] = lambda msg: print("log:", msg)
log("started")
let ignore: Callable[[int], None] = lambda x: x * 2
ignore(1)

# A lambda without parameters infers its type.
let zero = lambda: 0
print(zero() + 1)

# Identity: a top-level function is always the same value; each lambda evaluation is a new one.
let f = double
print(f == double, f(21))
let make = lambda: lambda: 1
print(make() == make())
let same = make()
print(same == same, [same] == [same])

print(double, zero)
print([double])
print(b)

# Widening happens inside a lambda's body, not between function types.
let to_float: Callable[[int], float] = lambda x: x
print(to_float(3))

# Parameters named _ are ignored.
let second: Callable[[int, int], int] = lambda _, y: y
print(second(1, 2))

# A parameterless lambda whose body returns nothing is a Callable[[], None].
let hello = lambda: print("hello")
hello()
