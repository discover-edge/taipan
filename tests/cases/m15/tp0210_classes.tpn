# Members are looked up on the static type, and fields must be declared (SPEC §3.9, §4.3).
class Animal:
    name: str

    def __init__(self, name: str):
        self.name = name
        self.age = 3

class Dog(Animal):
    def __init__(self, name: str):
        super().__init__(name)

    def fetch(self):
        pass

let a: Animal = Dog("rex")
a.fetch()
var v: Animal = Dog("rex")
if isinstance(v, Dog):
    v.fetch()
let o: Animal? = a
if o is not None:
    print(o.name)
var w: Animal? = a
if w is not None:
    print(w.name)

class Holder:
    pet: Animal? = None

    def name(self) -> str:
        if self.pet is not None:
            return self.pet.name
        return ""
