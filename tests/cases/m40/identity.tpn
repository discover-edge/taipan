# 'is' between objects compares identity (SPEC §3.18).
class Animal:
    name: str

    def __init__(self, name: str):
        self.name = name

class Dog(Animal):
    pass

@dataclass
class Point:
    x: int

let a = Animal("a")
let d = Dog("d")
let other: Animal = d
print(a is a, a is d, other is d, other is not d)
let p = Point(1)
let q = Point(1)
print(p == q, p is q, p is not q)
let xs = [1, 2]
let ys = xs
print(xs is ys, xs is [1, 2], xs == [1, 2])
let maybe: Animal? = None
print(maybe is a, maybe is not a)
let f: Callable[[], int] = lambda: 1
print(f is f)
