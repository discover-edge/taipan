# Comprehensions and generator expressions (SPEC §3.16, M36).
def naturals() -> Iterator[int]:
    var n = 0
    while True:
        print("produce", n)
        yield n
        n += 1

let xs = [3, 1, 4, 1, 5, 9, 2, 6]
print([x * x for x in xs if x % 2 == 1])
print([(c, n) for c in "ab" for n in [1, 2]])
print([[i * j for j in range(1, 4)] for i in range(1, 3)])
print({w: len(w) for w in ["hi", "taipan", "py"]})
print({x % 3 for x in xs})
let ages = {"ann": 31, "bob": 24}
print([f"{name}={age}" for name, age in ages.items() if age > 25])
print({v: k for k, v in ages.items()})
print(sum(x for x in xs), max(len(w) for w in ["a", "abc", "ab"]))
print(any(x > 8 for x in xs), all(x > 0 for x in xs))
let lazy = (n * 10 for n in naturals() if n % 2 == 0)
print("made")
print(next(lazy))
print(next(lazy))
let maybe: list[int?] = [1, None, 3]
print([n + 1 for n in maybe if n is not None])
let x = "outer"
print([x for x in range(3)], x)
# Each iteration's variable is captured, so these return 0, 1 and 2, where Python's all return 2.
let fs = [lambda: i for i in range(3)]
print([f() for f in fs])
print([c.upper() for c in "abc" if c != "b"], list(w for w in "xy"))
let floats: list[float] = [n for n in [1, 2]]
print(floats, sorted(x for x in {3, 1, 2}))
