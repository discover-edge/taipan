# A library's C# (SPEC §8, §14): an internal TaipanLibrary, and a public class for the module
# with wrappers that initialize it, and its classes and enums nested inside.
from python import json

const LIMIT = 10

enum Size:
    Small
    Large(factor: float)

@dataclass
class Point:
    x: float
    y: float = 0.0

class Counter:
    count: int

    def __init__(self, start: int = 0):
        self.count = start

    def bump(self, by: int = 1) -> int:
        self.count += by
        return self.count

def identity[T](value: T) -> T:
    return value

def clamp(n: int, high: int = LIMIT) -> int:
    if n < high:
        return n
    return high

def encode(n: int) -> str:
    return json.dumps(n) as str

def _helper() -> int:
    return 1
