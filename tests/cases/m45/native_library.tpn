# What a native library exports, checked with --library --native (SPEC §15.6).
def area(width: float, height: float) -> float:
    return width * height

def label(name: str, sides: int, regular: bool = True) -> str:
    return f"{name} {sides} {regular}"

def _helper() -> int:
    return 1

def total(xs: list[float]) -> float:
    return sum(xs)

def first[T](x: T) -> T:
    return x

async def later() -> int:
    return 1

def joined(*parts: str) -> str:
    return "".join(parts)

def scaled(x: float, *, by: float) -> float:
    return x * by
