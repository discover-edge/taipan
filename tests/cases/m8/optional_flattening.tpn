# Optionals don't nest through substitution or d.get (SPEC §3.4, §3.6).
def first[T](xs: list[T]) -> T?:
    for x in xs:
        return x
    return none

let opts: list[int?] = [none, 1]
let got: int? = first(opts)
print(got, first(opts) ?? -1)
let scores: dict[str, int?] = {"ann": none, "bob": 7}
print(scores.get("ann"), scores.get("bob"), scores.get("cid"), scores.get("bob") ?? 0)
