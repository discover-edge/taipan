# Decorators that can't be used, or combined (SPEC §2, §4.8).
class Base:
    def speak(self) -> str:
        return ""

class C(Base):
    @staticmethod
    @classmethod
    def both() -> int:
        return 0

    @property
    @staticmethod
    def p(self) -> int:
        return 0

    @abstractmethod
    def not_abc(self) -> int: ...

    @size.setter
    def size(self, value: int):
        pass

    @speak.getter
    def other(self) -> int:
        return 0

    @property
    def __str__(self) -> str:
        return ""

class Shape(ABC):
    @abstractmethod
    @staticmethod
    def make() -> int: ...

class Square(Base, ABC):
    @abstractmethod
    @override
    def speak(self) -> str: ...

@property
def top() -> int:
    return 0

@staticmethod
class Wrong:
    pass
