# Unreachable code is warning TP0300 (SPEC §3.10, §4.5).
def after_return() -> int:
    return 1
    print("never")
    print("not reported twice")

def after_raise(fail: bool):
    if fail:
        raise ValueError("v")
        print("never")
    print("reachable")

def after_if(x: int) -> int:
    if x > 0:
        return 1
    else:
        return 2
    return 3

def loops():
    for i in range(3):
        if i == 1:
            continue
            print("never")
        break
        print("never")
    while True:
        return
    print("loops never terminate")

def clauses():
    try:
        print(after_return())
    except LookupError:
        print("lookup")
    except KeyError:
        print("key")
    except (IndexError, ValueError):
        print("index or value")
    except Exception as e:
        print(e)
    except ValueError:
        print("value")

after_raise(False)
print(after_if(1))
loops()
clauses()
