# Before M29 a match expression was only the whole value of 'let', 'var', an assignment or 'return' (SPEC §2).
# Since M29 it's an atom, whose colon ends its line, so only line 4 is an error.
let n = 3
print(match n: _: 1)
let x = 1 + match n:
    _: 1
let f = lambda m: match m:
    _: 1
let y = match n:
    _:
        1
print("done")
