enum Shape:
    Circle(radius: float)
    Rect(width: float, height: float)
    Dot

def area(s: Shape) -> float:
    match s:
        Circle(r):
            return 3.0 * r * r
        Rect(w, h): return w * h
        Dot: return 0.0

let shapes = [Circle(1.0), Shape.Rect(width=2, height=3), Dot, Shape.Dot]
for s in shapes:
    print(s, area(s))
print(Circle(1.0) == Circle(1.0), Circle(1.0) == Circle(2.0), Dot == Shape.Dot, Dot != Circle(0.0))
print(shapes)

enum Tree:
    Leaf
    Node(left: Tree, value: int, right: Tree)

def total(t: Tree) -> int:
    match t:
        Leaf: return 0
        Node(l, v, r): return total(l) + v + total(r)

def depth(t: Tree) -> int:
    match t:
        Node(l, _, r):
            let a = depth(l)
            let b = depth(r)
            if a > b:
                return a + 1
            return b + 1
        _: return 0

let tree = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Node(Leaf, 4, Leaf)))
print(total(tree), depth(tree))
print(Node(Leaf, 1, Leaf))
