# yield as an expression, bare yield, and yield from's value and delegation (SPEC §3.20).
def doubler() -> Generator[int?, int, None]:
    var x = yield
    while x > 0:
        x = yield x * 2

let d = doubler()
print(next(d))
print(d.send(3), d.send(5))
try:
    d.send(0)
except StopIteration as e:
    print("stopped", e.value)

def running_total() -> Generator[int, int, None]:
    var total = 0
    while True:
        total += yield total

let r = running_total()
print(next(r), r.send(5), r.send(7))

def once() -> Generator[str, str, str]:
    return (yield "ask")

let o = once()
print(next(o))
try:
    o.send("answer")
except StopIteration as e:
    print("got", e.value)

def shout() -> Generator[None, str, None]:
    while True:
        print((yield).upper())

let sh = shout()
next(sh)
sh.send("hi")
sh.send("there")

def inner() -> Generator[int, int, str]:
    try:
        let x = yield 1
        print("inner got", x)
        yield 2
    except ValueError:
        print("inner caught")
        yield 3
    finally:
        print("inner finally")
    return "inner done"

def outer() -> Generator[int, int, None]:
    let r = yield from inner()
    print("outer got", r)
    yield 4

let g = outer()
print(next(g))
print(g.send(7))
print(g.throw(ValueError("x")))
print(next(g))
print(next(g, -1))

let g2 = outer()
next(g2)
g2.close()
print(next(g2, -1))

def numbers() -> Iterator[int]:
    yield from [1, 2]
    yield from (n * 10 for n in range(1, 3))
    yield from [3]

def sum_all(xs: Iterable[int]) -> int:
    var s = 0
    for x in xs:
        s += x
    return s

print(list(numbers()), sum_all(numbers()))

def answer() -> Generator[int, None, int]:
    yield 1
    return 42

print([x for x in answer()], sum(answer()))
let a = answer()
for x in a:
    print("value", x)
print(next(a, 0))
