# Generators' types: yield's value, return values, yield from's value, and send (SPEC §3.20).
def bare() -> Iterator[int]:
    yield

def counted(n: int) -> Iterator[int]:
    yield n
    return n

def unfinished(n: int) -> Generator[int, None, str]:
    yield n

def flattened() -> Generator[int, None, None]:
    let rest = yield from [1, 2]
    print(rest)

def wants_str() -> Generator[int, str, None]:
    let s = yield 1
    print(s)

def mismatched() -> Generator[int, int, None]:
    yield from wants_str()

def typed() -> Generator[int, int, str]:
    let x: str = yield 1
    return x

let g = typed()
g.send("one")
let r: str = typed().send(1)

def answer() -> Generator[int, None, int]:
    yield 1
    return 2

let a = answer()
try:
    next(a)
except StopIteration as e:
    print(e.value + 1)
    print(e.value.real)
    print(len(e.value))
