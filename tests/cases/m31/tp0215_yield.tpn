# Where yield can't be (SPEC §3.13).
def risky() -> Iterator[int]:
    try:
        yield 1
    except ValueError:
        yield 2
    finally:
        yield 3

def cleanup() -> Iterator[int]:
    try:
        yield 1
    finally:
        print("done")

def picked(n: int) -> Iterator[int]:
    let x = match n:
        0:
            yield 0
            1
        _: 2
    yield x

yield 5
