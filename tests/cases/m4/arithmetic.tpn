# Python semantics for // and % (SPEC §5.3); true division always gives a float.
print(7 // 2, -7 // 2, 7 // -2, -7 // -2)
print(7 % 3, -7 % 3, 7 % -3, -7 % -3, 6 % -3, 0 % 5)
print(-9223372036854775808 % -1, -9223372036854775808 // 2)
print(7 / 2, -7 / 2, 1 / 4, 3 / 1.5)
print(1 + 2.5, 2 * 0.5, 10 - 0.25, -(-3))
print(int(2.9), int(-2.9), int(5), float(3), float(0.5))
print(len("abc"), len(""), len("🐍é"))
var total = 0
for i in range(1, 101):
    total += i
print(total)
