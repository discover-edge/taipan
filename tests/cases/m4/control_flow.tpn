def classify(n: int) -> str:
    if n < 0:
        return "negative"
    elif n == 0:
        return "zero"
    elif n < 10:
        return "small"
    else:
        return "large"


for n in range(-1, 3):
    print(n, classify(n))
print(classify(50))

var i = 0
while True:
    i += 1
    if i % 2 == 0:
        continue
    if i > 7:
        break
    print("odd", i)

# range bounds are evaluated once, before the loop.
var limit = 3
for k in range(limit):
    limit += 10
    print("k", k)
print(limit)
for k in range(5, 2):
    print("never")
