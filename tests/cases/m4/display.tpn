# Display forms (SPEC §6), including Python-style float repr.
print(1, -42, 9223372036854775807, -9223372036854775808)
print(True, False, "text", "")
print(1.0, -0.0, 0.5, 2.5e-3, 1.5, 100.0, 3.14159)
print(0.0001, 0.00001, 1.5e-7, 1e15, 1e16, 1.2345678901234568e17, 123456789.125)
print(0.1 + 0.2, 1 / 3, 2 / 1, 10 / 4)
print(1e308 * 10, -1e308 * 10, 1e308 * 10 - 1e308 * 10)
print(str(7) + str(2.0) + str(True))
print()
print(f"{1} {2.5} {True} {"s"} {1 + 2 * 3} {{braces}} done")
print(f'tab\tquote" backslash\\ unicode: 🐍é')
