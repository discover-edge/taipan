# Hoisting, recursion and mutual recursion; all return paths covered.
print(is_even(10), fib(10))

def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def is_even(n: int) -> bool:
    if n == 0:
        return True
    return is_odd(n - 1)

def is_odd(n: int) -> bool:
    if n == 0:
        return False
    return is_even(n - 1)

def sign(n: int) -> int:
    if n > 0:
        return 1
    elif n < 0:
        return -1
    else:
        if n == 0:
            return 0
        else:
            return 0

def greet(name: str):
    if name == "":
        return
    print(f"hello, {name}!")

def to_float(n: int) -> float:
    return n

greet("taipan")
print(sign(-3), to_float(2))
