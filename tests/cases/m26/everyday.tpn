# '-> None', zip of more lists, and isinstance with a tuple of classes (SPEC §3.2, §6).
class Animal:
    name: str

    def __init__(self, name: str) -> None:
        self.name = name

class Mammal(Animal):
    def fur(self) -> str:
        return f"{self.name} has fur"

class Dog(Mammal):
    pass

class Cat(Mammal):
    pass

class Bird(Animal):
    pass

def greet(name: str) -> None:
    print(f"hello, {name}")

greet("taipan")
let f: Callable[[str], None] = greet
f("again")

for name, age, city in zip(["ann", "bo", "cy"], [31, 42, 27, 99], ["oslo", "rome", "lima"]):
    print(name, age, city)
print(zip([1, 2], ["a", "b"], [True, False], [1.5, 2.5]))

let pets: list[Animal] = [Dog("rex"), Cat("tom"), Bird("tweety")]
for pet in pets:
    # Narrowed to Mammal, the nearest class Dog and Cat derive from.
    if isinstance(pet, (Dog, Cat)):
        print(pet.fur())
    else:
        print(pet.name, "has feathers")
