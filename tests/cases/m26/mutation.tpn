# Slice assignment and del, as in Python (SPEC §5.5).
var xs = [0, 1, 2, 3, 4, 5]
xs[1:3] = [10, 20, 30]
print(xs)
xs[:0] = [-1]
xs[len(xs):] = [99]
print(xs)
xs[::2] = [7, 7, 7, 7, 7]
print(xs)
xs[2:5] = []
print(xs)
xs[1:] = xs
print(xs)
del xs[0]
del xs[-1]
print(xs)
del xs[::2]
print(xs)
del xs[10:20]
print(xs)

var fs: list[float] = [1.0, 2.0]
fs[1:1] = [1, 1.5]
print(fs)

var d = {"a": 1, "b": 2, "c": 3}
del d["b"]
d["b"] = 4
print(d)
let pair = [[1, 2], [3, 4]]
del pair[0][1], pair[1][0]
print(pair)

for bad in [lambda: _extended(), lambda: _missing(), lambda: _index(), lambda: _step()]:
    try:
        bad()
    except Exception as e:
        print(e)

def _extended():
    var ys = [1, 2, 3, 4]
    ys[::2] = [0]

def _missing():
    var d = {"a": 1}
    del d["z"]

def _index():
    var ys = [1, 2, 3]
    del ys[5]

def _step():
    var ys = [1, 2, 3]
    del ys[::0]
