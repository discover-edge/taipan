# Generic aliases, aliases of aliases, and aliases in every type position (SPEC §3.12).
type Pair[T] = tuple[T, T]
type Grid = list[Row]
type Row = list[int]
type Table[V] = dict[str, list[Pair[V]]]
type MaybeInt = int?
type Ignored[T] = str

def swap[T](p: Pair[T]) -> Pair[T]:
    return p[1], p[0]

def total(g: Grid) -> int:
    var sum = 0
    for row in g:
        for x in row:
            sum += x
    return sum

def first(xs: list[int]) -> MaybeInt?:
    if len(xs) == 0:
        return None
    return xs[0]

@dataclass
class Box[T]:
    item: T

print(swap((1, 2)))
print(swap(("a", "b")))
print(total([[1, 2], [3]]))

let t: Table[int] = {"a": [(1, 2)]}
t["b"] = [swap((3, 4))]
print(t)

print(first([]), first([7]))
let label: Ignored[float] = "ignored"
print(label)

# Type arguments and constraint tuples.
let boxed: Box[Pair[str]] = Box(("x", "y"))
print(boxed.item[0])

type Number = float
def double[N: (int, Number)](x: N) -> N:
    return x + x
print(double(2), double(1.5))
