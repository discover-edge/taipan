# Extension methods and explicit type arguments (SPEC §13.8, §13.15).
from dotnet.System.Linq import Enumerable
from dotnet.System import Array

let xs = [1, 2, 3, 4]
print(xs.Where(lambda x: x > 2).Select(str))
print(xs.Select(lambda x: x * 10).Sum())
print(["b", "c", "a"].Order())
print(xs.Any(lambda x: x > 3), xs.All(lambda x: x > 1))
print([3, 1, 3].ToHashSet().Count)
print(xs.Aggregate(0, lambda total, x: total + x))

let words = ["apple", "fig", "kiwi"]
print(words.OrderBy(lambda w: len(w)).First())
print(", ".join(words.Select(lambda w: w.upper())))

print(Enumerable.Empty[str](), len(Array.Empty[int]()))
print(Enumerable.Repeat[str]("ab", 2))
print(Enumerable.Range(1, 3).Select(lambda n: n * n))
