# Generic .NET types, written with type arguments (SPEC §13.13).
from dotnet.System.Collections.Generic import HashSet, Queue, Comparer, KeyValuePair, ISet

let seen = HashSet[str]()
print(seen.Add("a"), seen.Add("b"), seen.Add("a"))
print(seen.Count, seen.Contains("b"), seen.Contains("z"))
for s in seen:
    print(s)
print(sorted(seen), list(seen))

let unique = HashSet[int]([3, 1, 3, 2])
print(unique.Count, sum(unique), [n * 2 for n in unique])
let asSet: ISet[int] = unique
print(asSet.Contains(1))

let q = Queue[int]()
q.Enqueue(1)
q.Enqueue(2)
print(q.Dequeue(), q.Count)
print(q.TryDequeue())
print(q.TryDequeue())

let nested = Queue[list[int]]()
nested.Enqueue([1, 2])
print(nested.Peek())

print(Comparer[str].Default.Compare("a", "b"))
let pair = KeyValuePair[str, int]("x", 1)
print(pair.Key, pair.Value)
