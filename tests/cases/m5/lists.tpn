var xs = [3, 1, 2]
xs.append(5)
xs.insert(0, 9)
xs.insert(-1, 7)
xs.insert(100, 8)
xs.insert(-100, 0)
print(xs, len(xs))
print(xs[0], xs[-1], xs[-2])
xs[1] = 4
xs[-1] += 10
print(xs.pop(), xs)
print(3 in xs, 42 in xs, 42 not in xs, xs.contains(4))
let floats: list[float] = [1, 2.5]
let mixed = [1, 2.5]
print(floats, mixed, floats == mixed)
print([1, 2] + [3], [[1], [2, 3]], [["a"]])
let empty: list[int] = []
print(empty, len(empty), empty == empty)
var total = 0
for x in xs:
    total += x
print(total)
let nested: list[list[int]] = [[], [1]]
nested[0].append(7)
print(nested)
