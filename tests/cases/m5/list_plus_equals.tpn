class Box:
    items: list[int]

    def __init__(self):
        self.items = [1]

    def grow(self):
        self.items += [2]

let box = Box()
let held = box.items
box.grow()
box.items += [3]
print(held, box.items is held)

var calls = 0
def boxed(x: Box) -> Box:
    print("called")
    return x

boxed(box).items += [4]
print(held)

let rows = [[1], [2]]
let first = rows[0]
rows[0] += [5]
print(rows, first)

let table = {"a": [1]}
let entry = table["a"]
table["a"] += [6]
print(table["a"], entry)

