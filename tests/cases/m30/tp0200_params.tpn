# *args and **kwargs take their element type; unpacking needs a tuple, list or dict (SPEC §4.2).
def f(*names: str) -> int:
    return len(names)

def g(**counts: int) -> int:
    return len(counts)

print(f("a", 1))
print(g(a="x"))
print(f(*[1, 2]))
print(g(**{"a": "x"}))
print(f(*5))
print(g(**{1: 2}))
let h = f
let m = map(g, [1])
