print(reversed(x for x in [1]))
print(reversed((1, "a")))
print(reversed(1))
print(reversed())
print(reversed([1], [2]))
print(reversed([1], key=1))
for v in range(step=1):
    print(v)
print([v for v in range(stop=1)])
